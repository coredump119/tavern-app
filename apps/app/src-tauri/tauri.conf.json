{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tavern",
  "version": "0.0.8",
  "identifier": "dev.coredump119.tavern",
  "build": {
    "beforeDevCommand": "pnpm --filter @tm/app dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @tm/app build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tavern",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**"] },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
